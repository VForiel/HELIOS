{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Frontend",
            "type": "npm",
            "script": "dev",
            "path": "web/frontend",
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^.*VITE v.*$",
                    "endsPattern": "^.*Local:.*http://localhost:.*$"
                }
            },
            "detail": "Starts the Vite development server",
            "isBackground": true,
            "presentation": {
                "group": "workbench",
                "reveal": "always",
                "panel": "new"
            }
        },
        {
            "label": "Start Backend (Shell)",
            "type": "shell",
            "command": "python web/backend/app.py",
            "options": {
                "env": {
                    "PYTHONPATH": "${workspaceFolder}/src"
                }
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Install Backend Dependencies",
            "type": "shell",
            "command": "pip install -r requirements.txt",
            "problemMatcher": []
        }
    ]
}